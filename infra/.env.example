# Copy to infra/.env (`make env`). For a laptop only: the server has its own compose and secrets.
# Passwords go into database URLs, so use only letters, digits and "-".

POSTGRES_DB=jumbaq
# Superuser. Only db-setup uses it, to create the roles and the databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-password

# jumbaq_owner owns the tables and runs the migrations.
JUMBAQ_OWNER_PASSWORD=jumbaq-owner-dev-password
# jumbaq_app is the API and the worker. It cannot delete rows.
JUMBAQ_APP_PASSWORD=jumbaq-app-dev-password

# Browsers send a Secure cookie only over HTTPS, and Chrome and Firefox also to
# http://localhost. Set false only to test in Safari on a laptop.
JUMBAQ_FAMILY_COOKIE_SECURE=true
# Comma separated origins of the web app when it runs on another port, like http://localhost:3000.
JUMBAQ_CORS_ORIGINS=

# "stub" writes fixed stories with no network call. "claude" needs a key from
# console.anthropic.com. Never commit a real key: this repository is public.
JUMBAQ_AI_PROVIDER=stub
JUMBAQ_AI_API_KEY=

# Stripe in test mode (dashboard.stripe.com, Developers > API keys). Only sk_test_ keys work.
# The webhook secret comes from `stripe listen --forward-to localhost:8000/api/v1/billing/webhook`.
JUMBAQ_STRIPE_SECRET_KEY=
JUMBAQ_STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the parent back after paying.
JUMBAQ_WEB_APP_URL=http://localhost:3000

JUMBAQ_ENVIRONMENT=dev
JUMBAQ_LOG_LEVEL=INFO

# Ports on the host. Change them when another service on the laptop already uses one.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
