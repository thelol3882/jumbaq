[importlinter:contract:only-ai-providers-call-the-model]
name = Only ai.providers talks to the model SDK
type = forbidden
source_modules =
    jumbaq.main
    jumbaq.worker
    jumbaq.core
    jumbaq.families
    jumbaq.cases
    jumbaq.billing
    jumbaq.episodes
    jumbaq.ai.domain
    jumbaq.ai.services
    jumbaq.ai.repositories
    jumbaq.ai.prompts
    jumbaq.ai.parsing
forbidden_modules =
    anthropic
allow_indirect_imports = True

