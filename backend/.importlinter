    jumbaq.ai.prompts
    jumbaq.ai.providers
    jumbaq.ai.repositories
    jumbaq.ai.uow
    jumbaq.ai.services
    jumbaq.billing.domain
    jumbaq.billing.errors
    jumbaq.billing.events
    jumbaq.billing.models
    jumbaq.billing.providers
    jumbaq.billing.repositories
    jumbaq.billing.queries
    jumbaq.billing.uow
    jumbaq.billing.services
    jumbaq.billing.schemas
    jumbaq.billing.deps
    jumbaq.billing.routers
    jumbaq.episodes.domain
    jumbaq.episodes.uow
    jumbaq.episodes.services
    jumbaq.episodes.schemas
    jumbaq.episodes.deps
    jumbaq.episodes.routers
allow_indirect_imports = True

[importlinter:contract:ai-through-public]
name = ai uses no other domain module
type = forbidden
source_modules =
    jumbaq.ai
forbidden_modules =
    jumbaq.families
    jumbaq.cases
    jumbaq.billing
    jumbaq.episodes
allow_indirect_imports = True

