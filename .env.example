# Template of /root/jumbaq/.env on the server. Every key is declared in env.schema of
# luxen.yaml; `luxen env` checks the server .env against it. Laptops use infra/.env.example.
#
# Each change-me has a `generate` recipe there. From the repo root on the laptop, this
# writes the server .env with fresh values, without showing them:
#
#   while IFS= read -r line; do
#     case "$line" in *=change-me) k=${line%%=*}; echo "$k=$(luxen env gen "$k")" ;;
#                     *) echo "$line" ;; esac
#   done < .env.example \
#     | ssh <user>@<server> 'sudo tee /root/jumbaq/.env >/dev/null && sudo chmod 600 /root/jumbaq/.env'

POSTGRES_DB=jumbaq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

JUMBAQ_OWNER_PASSWORD=change-me
JUMBAQ_APP_PASSWORD=change-me

# The web app is on another host than the API, so the API allows it with CORS.
JUMBAQ_CORS_ORIGINS=https://jumbaq.fun

# "stub" until the key is set: with "claude" and no key the API does not start.
JUMBAQ_AI_PROVIDER=stub
JUMBAQ_AI_API_KEY=

# Stripe test mode. Without the keys the checkout answers billing.not_configured.
JUMBAQ_STRIPE_SECRET_KEY=
JUMBAQ_STRIPE_WEBHOOK_SECRET=

JUMBAQ_ENVIRONMENT=prod
JUMBAQ_LOG_LEVEL=INFO
